[Unit]
Description=Hermes OAuth Gateway (OpenAI-compatible)
After=network.target
Wants=network.target

[Service]
Type=simple
User=raspi5p
WorkingDirectory=/home/raspi5p/workspace/n8n-stack/hermes-oauth-gateway
Environment=PATH=/home/raspi5p/.hermes/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=/home/raspi5p/.hermes/.env
Environment=PYTHONUNBUFFERED=1
# Copilot CLI uses libsecret/DBus keyring for OAuth token storage
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/home/raspi5p/workspace/n8n-stack/hermes-oauth-gateway/venv/bin/uvicorn gateway:app --host 0.0.0.0 --port 5055 --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-oauth-gateway

[Install]
WantedBy=multi-user.target
