[Unit]
Description=Hermes API Server (OpenAI-compatible HTTP wrapper)
After=network.target hermes-gateway.service
Wants=hermes-gateway.service

[Service]
Type=simple
User=abyz-lab
WorkingDirectory=/home/abyz-lab/.hermes
EnvironmentFile=/opt/hermes/.env
Environment=HERMES_BIN=/home/abyz-lab/.local/bin/hermes
Environment=API_SERVER_PORT=8643
ExecStart=/home/abyz-lab/.hermes/hermes-agent/venv/bin/python3 /opt/hermes/hermes-api-server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-api-server

[Install]
WantedBy=multi-user.target
