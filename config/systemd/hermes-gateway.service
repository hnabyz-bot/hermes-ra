[Unit]
Description=Hermes Agent Gateway (T3610)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abyz-lab
WorkingDirectory=/home/abyz-lab/.hermes
EnvironmentFile=/opt/hermes-ra/.env
ExecStart=/home/abyz-lab/.local/bin/hermes gateway
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
