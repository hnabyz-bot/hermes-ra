# Hermes RA User Configuration
# Copy to ~/.hermes/.env and fill in your actual values

# OpenProject
OPENPROJECT_API_KEY=xxxxxxxxxxxx
OPENPROJECT_BASE_URL=https://your-openproject-instance.com

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333

# NAS 경로
NAS_RA_PATH=/mnt/nas-ra/공통자료/RA

# Ollama (임베딩)
OLLAMA_BASE_URL=http://localhost:11434

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=xxxxxxxxxxxx
