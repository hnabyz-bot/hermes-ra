# System-wide Hermes RA Configuration
# Copy to: /opt/hermes-ra/.env
# chmod 600 /opt/hermes-ra/.env

# === 필수 항목 ===

# OpenProject
OPENPROJECT_API_KEY=xxxxxxxxxxxx
OPENPROJECT_BASE_URL=https://your-openproject-instance.com

# hermes-api-server Bearer 인증
API_SERVER_KEY=

# === 인프라 (기본값 사용 가능) ===

# Qdrant 벡터 DB (로컬, 포트 6333)
QDRANT_URL=http://localhost:6333

# Ollama — qwen3-embedding (GX10 Ollama, 포트 11434)
OLLAMA_URL=http://192.168.100.1:11434
EMBED_MODEL=qwen3-embedding:latest

# Hermes Agent 바이너리
HERMES_BIN=/home/abyz-lab/.local/bin/hermes
HERMES_TIMEOUT=120
RAG_TIMEOUT=60

# NAS 마운트 경로
NAS_RA_PATH=/mnt/nas-ra/공통자료/RA

# API 서버 포트
API_SERVER_PORT=8643
HERMES_RA_DIR=/opt/hermes-ra
