# System-wide Hermes Configuration
# Copy to: /opt/hermes/.env
# chmod 600 /opt/hermes/.env

# === 필수 항목 ===

# Zhipu AI (GLM-4.5-air) — https://open.bigmodel.cn/
GLM_API_KEY=sk_xxxxxxxxxxxxx

# OpenProject
OPENPROJECT_API_KEY=xxxxxxxxxxxx
OPENPROJECT_BASE_URL=https://your-openproject-instance.com

# === 인프라 (기본값 사용 가능) ===

# Qdrant 벡터 DB (로컬, 포트 6333)
QDRANT_URL=http://localhost:6333

# Ollama (nomic-embed-text 임베딩, 포트 11434)
OLLAMA_URL=http://localhost:11434

# Hermes OAuth Gateway (Codex/Copilot 라우팅, 포트 5055)
OAUTH_GATEWAY_URL=http://localhost:5055

# NAS 마운트 경로
NAS_RA_PATH=/mnt/nas-ra/공통자료/RA

# === 선택 항목 ===

# n8n (워크플로우 오케스트레이션)
# N8N_URL=http://localhost:5678
